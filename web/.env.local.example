# Copy to .env.local in this directory (never commit .env.local).
# From repo root:  cp web/.env.local.example web/.env.local

# --- Supabase (Project Settings → API) ---
# URL must be https://YOUR_PROJECT_REF.supabase.co — not the bare ref.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp automation (FastAPI) ---
# Local Next dev: point at your machine.
CHATLOG_AUTOMATION_URL=http://127.0.0.1:8000
# If you test against a tunnel (same URL as Vercel prod), use that https URL here instead.
CHATLOG_AUTOMATION_SECRET=

# Must be identical to whatsapp-service/.env CHATLOG_AUTOMATION_SECRET

# --- Optional: order extraction from chats (server-side only) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=                    # default: gemini-1.5-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=                # default: google/gemma-2-9b-it:free
# RESEND_API_KEY=
