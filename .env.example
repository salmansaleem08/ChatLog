# =============================================================================
# ChatLog — environment variables (NO real secrets in git)
# =============================================================================
# Copy values into:
#   • web/.env.local           — from web/.env.local.example (local Next.js)
#   • whatsapp-service/.env    — from whatsapp-service/.env.example (local automation)
#   • Vercel → Project → Settings → Environment Variables
#   • Render → Service → Environment
#
# Never commit .env, .env.local, or files containing keys.

# -----------------------------------------------------------------------------
# Shared values (same Supabase project everywhere)
# -----------------------------------------------------------------------------
# Public key is safe in the browser (NEXT_PUBLIC_*). URL must be full HTTPS, not the raw project ref.
# Example URL shape: https://xxxxxxxxxxxx.supabase.co  (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# API Settings: legacy "anon" / "public" JWT (eyJ...) or newer publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC. Full access; keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# WhatsApp automation (FastAPI) — server-to-server only on Vercel
# -----------------------------------------------------------------------------
# Public HTTPS base URL of the automation API (no trailing slash required).
# • Render: https://your-service.onrender.com
# • Laptop + Vercel: tunnel to local uvicorn, e.g. https://xxxx.ngrok-free.app
#   See docs/VERCEL_FRONTEND_LOCAL_BACKEND.md — Vercel cannot use http://127.0.0.1
CHATLOG_AUTOMATION_URL=
# Same random secret must be set on Render as CHATLOG_AUTOMATION_SECRET.
CHATLOG_AUTOMATION_SECRET=

# -----------------------------------------------------------------------------
# AI & email (assign to Vercel and/or Render depending where that code runs)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Python service only (Render + optional local whatsapp-service/.env)
# -----------------------------------------------------------------------------
# Same project as NEXT_PUBLIC_SUPABASE_URL — full HTTPS URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Render sets PORT automatically — do not override on Render unless required.

# -----------------------------------------------------------------------------
# WhatsApp service (Python / Docker on Render) — optional
# -----------------------------------------------------------------------------
# Render FREE tier: leave unset — service uses /tmp (session lost on restart/redeploy).
# Paid persistent disk: set to the mounted path. Do NOT use /var/data/... without a disk.
WHATSAPP_SESSION_DIR=
# Seconds to wait for the login QR canvas (default 40). Lower only for debugging.
WHATSAPP_QR_WAIT_SEC=
# Force headless locally: HEADLESS=1  (Render sets RENDER=true → headless)
HEADLESS=
