# Copy to .env in this directory (never commit .env).
# Used by: load_dotenv() in main.py

# Required — must match web/.env.local CHATLOG_AUTOMATION_SECRET exactly
CHATLOG_AUTOMATION_SECRET=

# Where Chrome stores per-business profiles (use a path you own on your machine).
# macOS/Linux example (replace with your repo path):
# WHATSAPP_SESSION_DIR=/Users/you/Documents/ChatLog/whatsapp-service/data/wa_sessions
WHATSAPP_SESSION_DIR=

# Optional: seconds to wait for QR canvas (default 40)
# WHATSAPP_QR_WAIT_SEC=45

# Use HEADLESS=1 to scan QR only in the ChatLog website (no separate Chrome window).
# Leave unset only if you want a visible browser for debugging.
# HEADLESS=1

# Optional — only if Selenium cannot find your Chrome (macOS Google Chrome):
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROMEDRIVER_PATH=   (leave empty to use Selenium Manager)

# Future Python features (unused by current main.py):
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# RESEND_API_KEY=
